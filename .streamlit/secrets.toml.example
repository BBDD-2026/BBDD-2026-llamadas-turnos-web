# Copiá a  secrets.toml  para probar en local (gitignoreado), o pegá el contenido
# en Streamlit Community Cloud → App → Settings → Secrets.

# --- Sal para anonimizar el teléfono (OBLIGATORIA si se suben .rsl online) ---
# Cadena aleatoria fija. Si también usás publicar.py, poné acá EXACTAMENTE el
# contenido de  data/.salt  (así los hashes coinciden entre las dos formas).
salt = "cambiame-por-una-cadena-larga-y-aleatoria"

# --- Usuarios ---
[passwords]
enzo        = "clave-de-enzo"
supervisor  = "clave-del-super"
tmk         = "clave-compartida-tmk"
# (alternativa: una sola clave -> reemplazá [passwords] por:  password = "clave-unica")

# --- Persistencia opcional: guardar las cargas en el repo (redeploy) ---
# Sin esto, lo que se sube por el panel vive sólo hasta que la app se reinicia.
# El token necesita permiso de escritura (contents) SOLO sobre este repo.
# [github]
# token  = "github_pat_..."
# repo   = "BBDD-2026/BBDD-2026-llamadas-turnos-web"
# path   = "data/publico.parquet"
# branch = "main"
