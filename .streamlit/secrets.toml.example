# Copiá este archivo a  secrets.toml  para probar en local (está gitignoreado),
# o pegá su contenido en Streamlit Community Cloud → App → Settings → Secrets.

# --- Opción A: varios usuarios (recomendado) ---
[passwords]
enzo        = "clave-de-enzo"
supervisor  = "clave-del-super"
tmk         = "clave-compartida-tmk"

# --- Opción B: una sola clave para todo el equipo ---
# (usá esta O la sección [passwords], no las dos)
# password = "clave-unica"
